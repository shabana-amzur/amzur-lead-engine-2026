PORT=3001
JWT_SECRET=your_secret_here
DATABASE_URL=postgresql://user:password@localhost:5432/amzurleads
NODE_ENV=development
TAVILY_API_KEY=your_key_here
APOLLO_API_KEY=your_key_here
OPENAI_API_KEY=your_key_here

# Web search providers, tried in this order (set at least one):
# Tavily (https://tavily.com), then Serper/Google (https://serper.dev), then You.com (https://you.com/platform)
SERPER_API_KEY=your_key_here
YOU_API_KEY=your_key_here

# Optional: minimum minutes between web searches when the dashboard refreshes (0 = every refresh)
SCAN_COOLDOWN_MINUTES=0

# Press / news / RFP leads are read for intent: vendor already selected, contract
# awarded or partnership announced -> dropped; unclear -> "Review required".
# Uses OPENAI_API_KEY when it works (model below), otherwise built-in rules.
OPENAI_INTENT_MODEL=gpt-4o-mini

# Skip companies whose profile shows more employees than this (too large to reach).
MAX_COMPANY_EMPLOYEES=10000
