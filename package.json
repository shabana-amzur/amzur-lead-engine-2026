{
  "name": "amzur-lead-engine",
  "version": "1.0.0",
  "private": true,
  "description": "Amzur Lead Engine - Full-stack lead discovery platform",
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
